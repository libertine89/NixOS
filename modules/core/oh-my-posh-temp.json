{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
           "template": "\u2591\u2592\u2593",
          "foreground": "#0A0373",
          "background": "#00000000"
        },
        {
          "type": "os",
          "style": "plain",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}  ",
          "foreground": "p:text-light",
          "background": "#0A0373"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\ue0bc",
          "foreground": "#0A0373",
          "background": "#FFFFFF"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\ue0bc",
          "foreground": "#FFFFFF",
          "background": "#1C1690"
        },
        {
          "type": "text",
          "style": "plain",
          "template": ",",
          "foreground": "#1C1690",
          "background": "#1C1690"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\ue0bc",
          "foreground": "#1C1690",
          "background": "#3A36B5"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:text-light",
          "background": "#3A36B5",
          "template": " {{ if eq .Path \"~\" }} Home{{ else if eq .Path \"/\" }}󰌽 Root{{ else }}{{ .Path }}{{ end }} ",
          "options": {
            "style": "full",
            "max_depth": "4",
            "mapped_locations": {
              "~/Desktop": " Desktop",
              "~/Documents": "󰈙 Docs",
              "~/Downloads": " Downloads",
              "~/Pictures": " Pictures",
              "~/Videos": " Videos",
              "~/Music": " Music",
              "~/Projects": "󰲋 Projects",
              "~/Dev": "󰅨 Dev",
              "~/Code": "󰨞 Code",
              "~/Git": "󰊢 Git",
              "~/NixOS": " NixOS",
              "~/Workspace": "󰙅 Workspace"
            }
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#3A36B5",
          "background": "#00000000"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#3A36B5",
          "background": "#00000000"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#3A36B5",
          "background": "#3A36B5"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:text-light",
          "background": "#3A36B5",
          "template": " {{ .HEAD }} {{ if gt .Ahead 0 }} ↑{{ .Ahead }} {{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }} {{ end }}{{ if .Working.Changed }} ! {{ end }}{{ if .Staging.Changed }} + {{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": "\uf126 "
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": " ",
          "foreground": "#3A36B5",
          "background": "#1C1670"
        },
        {
          "type": "go",
          "style": "plain",
          "template": "\ue724 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "lua",
          "style": "plain",
          "template": " \ue620 {{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "python",
          "style": "plain",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "rust",
          "style": "plain",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "node",
          "style": "plain",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#1C1670",
          "background": "#FFFFFF"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#FFFFFF",
          "background": "#020152"
        },
        {
          "type": "time",
          "style": "plain",
          "template": " \uf017 {{ .CurrentDate | date \"15:04\" }} ",
          "foreground": "#FFFFFF",
          "background": "#020152"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\u2593\u2592\u2591",
          "foreground": "#020152",
          "background": "#00000000"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "❯",
          "foreground": "p:text"
        }
      ]
    }
  ],
  "palette": {
    "text-light": "#ffffff",
    "path-bg": "#61AFEF",
    "git-bg": "#98C379"
  }
}
