{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "░▒▓",
          "foreground": "p:darkOnPrimary",
          "background": "#00000000"
        },
        {
          "type": "os",
          "style": "plain",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}  ",
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimary"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkOnPrimary",
          "background": "#FFFFFF"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "text",
          "style": "plain",
          "template": ",",
          "foreground": "p:darkOnPrimaryFixedVariant",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkOnPrimaryFixedVariant",
          "background": "p:darkInversePrimary"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#FFFFFF",
          "background": "p:darkInversePrimary",
          "template": " {{ if eq .Path \"~\" }} Home{{ else if eq .Path \"/\" }}󰌽 Root{{ else }}{{ .Path }}{{ end }} ",
          "options": {
            "style": "full",
            "max_depth": "4",
            "mapped_locations": {
              "~/Desktop": " Desktop",
              "~/Documents": "󰈙 Docs",
              "~/Downloads": " Downloads",
              "~/Pictures": " Pictures",
              "~/Videos": " Videos",
              "~/Music": " Music",
              "~/Projects": "󰲋 Projects",
              "~/Dev": "󰅨 Dev",
              "~/Code": "󰨞 Code",
              "~/Git": "󰊢 Git",
              "~/NixOS": " NixOS",
              "~/Workspace": "󰙅 Workspace"
            }
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkInversePrimary",
          "background": "#00000000"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkInversePrimary",
          "background": "#00000000"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkInversePrimary",
          "background": "p:darkInversePrimary"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FFFFFF",
          "background": "p:darkInversePrimary",
          "template": " {{ .HEAD }} {{ if gt .Ahead 0 }} ↑{{ .Ahead }} {{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }} {{ end }}{{ if .Working.Changed }} ! {{ end }}{{ if .Staging.Changed }} + {{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": " "
          }
        },
        {
          "type": "text",
          "style": "plain",
          "template": " ",
          "foreground": "p:darkInversePrimary",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "go",
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "lua",
          "style": "plain",
          "template": "  {{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "python",
          "style": "plain",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "rust",
          "style": "plain",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "node",
          "style": "plain",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimaryFixedVariant"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "p:darkOnPrimaryFixedVariant",
          "background": "#FFFFFF"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "",
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimary"
        },
        {
          "type": "time",
          "style": "plain",
          "template": "  {{ .CurrentDate | date \"15:04\" }} ",
          "foreground": "#FFFFFF",
          "background": "p:darkOnPrimary"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "▓▒░",
          "foreground": "p:darkOnPrimary",
          "background": "#00000000"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "❯",
          "foreground": "#FFFFFF"
        }
      ]
    }
  ],
