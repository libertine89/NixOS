{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "p:text-light",
          "background": "#0A0373",
          "leading_powerline_symbol": "\u2591\u2592\u2593"
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "template": ",",
          "foreground": "p:text-light",
          "background": "#FFFFFF"
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "template": ",",
          "foreground": "#1C1690",
          "background": "#1C1690"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "foreground": "p:text-light",
          "background": "#3A36B5",
          "template": " \uf07c {{ .Path }} ",
          "options": {
            "style": "folder"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "foreground": "p:text-light",
          "background": "#2A2680",
          "template": " \uf126 {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} ",
          "leading_powerline_symbol": "\ue0b6",
          "options": {
            "fetch_status": true
          }
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": "\ue724 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "lua",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": " \ue620 {{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "168h",
            "strategy": "folder"
          },
          "foreground": "p:text-light",
          "background": "#1C1970"
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\ue0b8",
          "template": ",",
          "foreground": "p:text-light",
          "background": "#FFFFFF"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\u2593\u2592\u2591",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "foreground": "p:text-light",
          "background": "#020152"
        }
      ]
    }
  ],
  "palette": {
    "text-light": "#ffffff",
    "path-bg": "#61AFEF",
    "git-bg": "#98C379"
  }
}
